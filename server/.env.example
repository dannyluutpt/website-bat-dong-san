# Cấu hình Server
PORT=5000
NODE_ENV=development

# URL của Front-end (phục vụ chặn CORS bảo mật)
CLIENT_URL=http://localhost:5173

# Cấu hình Cơ sở dữ liệu
# Lưu ý: Nếu để trống, server sẽ tự động chạy SQLite cục bộ (lưu thành file database.sqlite).
# Nếu muốn chuyển lên Production PostgreSQL, cấu hình url dạng: postgres://user:password@host:port/dbname
DATABASE_URL=

# Cấu hình Email gửi thông báo (SMTP)
# Sử dụng để tự động gửi thông báo cho Agent khi có Lead mới đăng ký.
# Ví dụ cho Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=môi_giới@gmail.com
# SMTP_PASS=mã_ứng_dụng_gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Email nhận thông báo Lead
NOTIFICATION_EMAIL=chau.nguyen@primeestates.vn
